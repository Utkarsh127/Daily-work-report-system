# Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Replace with your actual MongoDB URI, e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/wrs?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/wrs

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key_here_please_change_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting (Optional, defaults set in code)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
